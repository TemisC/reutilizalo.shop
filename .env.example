# Copia este archivo a .env.local y completa los valores de tu proyecto de Supabase
# (Project Settings → API).
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx

# URL pública del sitio (links para compartir, Open Graph).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Regla de lanzamiento de Explorar: true = todas las tiendas (Pro primero); false = solo Pro.
EXPLORE_INCLUDE_FREE_STORES=true
